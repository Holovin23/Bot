# Скопируйте этот файл в .env и впишите свои значения.
# Файл .env не попадает в git. Никогда не вставляйте ключи в чат.

# Ключ API демо-счёта Bybit (права: чтение + торговля, БЕЗ вывода средств)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# demo | live. Реальный счёт (live) дополнительно требует ALLOW_LIVE=true.
BYBIT_ENV=demo
ALLOW_LIVE=false

# Понадобятся позже (этап 6)
# ANTHROPIC_API_KEY=
# TG_API_ID=
# TG_API_HASH=
