# Скопируйте этот файл в .env и впишите свои значения.
# Файл .env не попадает в git. Никогда не вставляйте ключи в чат.

# Ключ API демо-счёта Bybit (права: чтение + торговля, БЕЗ вывода средств)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# demo | live. Реальный счёт (live) дополнительно требует ALLOW_LIVE=true.
BYBIT_ENV=demo
ALLOW_LIVE=false

# Этап 6: Claude API для разбора постов (console.anthropic.com)
ANTHROPIC_API_KEY=

# Этап 6: чтение Telegram-канала (my.telegram.org → API development tools)
TG_API_ID=
TG_API_HASH=

# Этап 7: уведомления в Telegram (бот от @BotFather и ваш chat id)
TG_BOT_TOKEN=
TG_CHAT_ID=
